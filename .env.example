# ---------------------------------------------------------------------------
# Polyglot — copy to .env and fill in what you have.
# .env is gitignored. Never commit real keys.
#
# You do NOT need all of these. Polyglot starts with zero keys; models whose
# provider has no key are shown as unavailable in the UI rather than failing at
# request time, and RAG falls back to the offline local embedding model.
# ---------------------------------------------------------------------------

# --- Providers -------------------------------------------------------------
# Required for the two mandated providers.
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey  (free tier is enough for this app)
GEMINI_API_KEY=

# At least one of the following (all optional):
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Server ----------------------------------------------------------------
PORT=8787
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# SQLite file. Use :memory: for an ephemeral run.
DATABASE_PATH=./data/polyglot.sqlite

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Tenants ---------------------------------------------------------------
# `npm run seed` creates two demo tenants with these keys so the isolation demo
# is reproducible. In production these would be issued, rotated and stored
# hashed — only the SHA-256 is ever persisted, even here.
SEED_TENANT_A_KEY=pk_demo_acme_do_not_use_in_production
SEED_TENANT_B_KEY=pk_demo_globex_do_not_use_in_production

# Optional: override the config directory (defaults to <repo>/config).
# POLYGLOT_CONFIG_DIR=
